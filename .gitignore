data/generated/*.parquet
__pycache__/
*.pyc
packages/

# Playwright browser profiles used by the UAT harness. These hold a live
# Google session -- Cookies, Login Data, tokens -- and were committed once by
# an over-broad `git add -A`. They are machine-local state, never source.
data/uat/.profile*/

# UAT recordings: ~500MB of .webm, regenerable by re-running scripts/uat_run.py.
data/uat/videos/
.DS_Store
data/uat/videos_prev_*/
data/uat/videos_uat_evidence_*/

# Dead-air-compressed copies of the referenced captures, produced by
# scripts/compress_referenced.py. Derived from data/uat/videos/, uploaded to
# GCS, never a source of truth.
data/uat/videos_tight/

# BigQuery-insight scenario captures: ~350MB of .webm across three takes,
# regenerable from the bq scenario harness.
data/uat/bq_scenarios/
data/uat/bq_scenarios_v1/
data/uat/bq_scenarios_v2_flawed/
